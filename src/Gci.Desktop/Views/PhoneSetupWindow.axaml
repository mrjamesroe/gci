<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Gci.Desktop"
        xmlns:vm="clr-namespace:Gci.App.ViewModels;assembly=Gci.Presentation"
        x:Class="Gci.Desktop.Views.PhoneSetupWindow"
        x:CompileBindings="False"
        Width="780" Height="600" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Ground}"
        Title="Phone alerts">
    <Grid Margin="24,20" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0">
            <TextBlock Text="Get watch alerts on your phone" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Alerts arrive through ntfy, a free notification app, even when you're away from this computer. Each alert has an Order now button that opens the product page." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0" ColumnDefinitions="*,24,280">
            <StackPanel Grid.Column="0">
                <TextBlock Text="1. Install ntfy on your phone" Classes="section" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="iPhone: App Store" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static vm:PhoneSetupViewModel.AppStoreUrl}" />
                    <Button Content="Android: Google Play" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static vm:PhoneSetupViewModel.PlayStoreUrl}" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="12" Margin="0,4,0,0" Text="Free, no account needed." />

                <TextBlock Text="2. Subscribe to your private topic" Classes="section" Margin="0,18,0,6" />
                <TextBlock TextWrapping="Wrap" Text="Android: scan the QR code with your camera. iPhone: open ntfy, tap +, and enter this topic:" />
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding TopicName}" FontFamily="monospace" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyTopicCommand}" Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <TextBlock Classes="muted" FontSize="12" Margin="0,4,0,0">
                    <Run Text="Server:" /><Run Text=" " /><Run Text="{Binding Server, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="3. Send a test" Classes="section" Margin="0,18,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Send test notification" Classes="primary" Command="{Binding SendTestCommand}" />
                    <ProgressBar Width="80" Height="6" IsIndeterminate="True" VerticalAlignment="Center" IsVisible="{Binding IsSending}" />
                </StackPanel>
                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Classes="muted" Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top" Padding="12">
                <StackPanel>
                    <Image Width="250" Height="250" Source="{Binding QrCodePng, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" />
                    <TextBlock Text="Android: scan to subscribe" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="iPhone: type the topic instead" HorizontalAlignment="Center" Classes="muted" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="8">
            <Button Content="Make a new topic" Command="{Binding NewTopicCommand}" />
            <Button Content="Turn off phone alerts" Click="OnTurnOff" />
            <Button Content="Done" Classes="primary" Click="OnDone" />
        </StackPanel>
    </Grid>
</Window>
