<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gci.Desktop.Views.MainWindow"
        Width="1100" Height="760" MinWidth="820" MinHeight="560"
        Title="GCI — Georgia Cannabis Inventory">
    <Border Padding="28">
        <StackPanel Spacing="10" VerticalAlignment="Top">
            <TextBlock Text="GCI — Georgia Cannabis Inventory" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Cross-platform (Avalonia) shell — Windows and macOS. UI porting in progress."
                       Opacity="0.7" />
            <TextBlock x:Name="Engine" Opacity="0.7" />
        </StackPanel>
    </Border>
</Window>
