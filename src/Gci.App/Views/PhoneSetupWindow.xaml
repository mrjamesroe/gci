<Window x:Class="Gci.App.Views.PhoneSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gci.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PhoneSetupViewModel}"
        Style="{StaticResource {x:Type Window}}"
        Title="Phone alerts" Width="780" Height="600" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Get watch alerts on your phone" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Alerts arrive through ntfy, a free notification app, even when you're away from this PC. Each alert has an Order now button that opens the product page for that store." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="1. Install ntfy on your phone" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="iPhone: App Store" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static vm:PhoneSetupViewModel.AppStoreUrl}" />
                    <Button Content="Android: Google Play" Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static vm:PhoneSetupViewModel.PlayStoreUrl}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="Free, no account needed." />

                <TextBlock Text="2. Subscribe to your private topic" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Android:" />
                    <Run Text="scan the QR code with your camera. ntfy opens and subscribes." />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run FontWeight="SemiBold" Text="iPhone:" />
                    <Run Text="open ntfy, tap +, and enter this topic:" />
                </TextBlock>
                <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyTopicCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding TopicName}" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="Server:" />
                    <Run Text="{Binding Server, Mode=OneWay}" />
                    <Run Text="(leave the app's default server as is)" />
                </TextBlock>

                <TextBlock Text="3. Send a test" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Send test notification" Style="{StaticResource PrimaryButton}" Command="{Binding SendTestCommand}" />
                    <ProgressBar Width="80" Height="6" IsIndeterminate="True" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                 Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="12">
                <StackPanel>
                    <Image Source="{Binding QrCode}" Width="250" Height="250" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock Text="Android: scan to subscribe" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="iPhone: type the topic instead" HorizontalAlignment="Center" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="OnDone" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Turn off phone alerts" Click="OnTurnOff" />
            <Button DockPanel.Dock="Right" Content="Make a new topic" Command="{Binding NewTopicCommand}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="The topic name is random. Anyone who knows it can read your alerts (product and store names only), so keep it to yourself. A new topic stops alerts to phones subscribed to the old one." />
        </DockPanel>
    </Grid>
</Window>
