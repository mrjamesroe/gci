<Window x:Class="Gci.App.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pvm="clr-namespace:Gci.App.ViewModels;assembly=Gci.Presentation"
        Style="{StaticResource {x:Type Window}}"
        Title="Before you use GCI" Width="720" Height="680" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource AccentDark}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="GCI — Georgia Cannabis Inventory" Foreground="White" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{x:Static pvm:Legal.Title}" Foreground="#A9C7B6" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <TextBlock Text="{x:Static pvm:Legal.Disclaimer}" TextWrapping="Wrap" LineHeight="20" MaxWidth="620" HorizontalAlignment="Left" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel>
                <CheckBox x:Name="AgreeCheck" Content="{x:Static pvm:Legal.AcceptLabel}" Checked="OnAgreeChanged" Unchecked="OnAgreeChanged" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Read the privacy details" Click="OnPrivacy" />
                    <Button Content="Decline &amp; quit" Click="OnDecline" />
                    <Button x:Name="AcceptButton" Content="I agree — continue" Style="{StaticResource PrimaryButton}"
                            Click="OnAccept" IsEnabled="False" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
