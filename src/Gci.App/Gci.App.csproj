<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 TFM is required for toast notifications. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>gci</AssemblyName>
    <RootNamespace>Gci.App</RootNamespace>
    <Product>GCI - Georgia Cannabis Inventory</Product>
    <!-- Shown as the app name on toast notifications. -->
    <AssemblyTitle>GCI</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\gci.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Standalone single-file publish (see README). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespace out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gci.Core\Gci.Core.csproj" />
    <ProjectReference Include="..\Gci.Presentation\Gci.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gci.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\gci.ico" />
    <!-- Scripts the Preorder window injects into store pages. -->
    <EmbeddedResource Include="Assets\prefill.js" LogicalName="Gci.App.Assets.prefill.js" />
    <EmbeddedResource Include="Assets\cart.js" LogicalName="Gci.App.Assets.cart.js" />
  </ItemGroup>

</Project>
