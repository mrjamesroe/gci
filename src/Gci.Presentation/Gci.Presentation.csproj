<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-agnostic presentation layer (ViewModels + platform-service interfaces) shared by the WPF and Avalonia apps. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gci.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Pure-managed PNG QR rendering (no System.Drawing), so the phone-setup VM stays cross-platform. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gci.Core\Gci.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gci.App.Tests" />
  </ItemGroup>

</Project>
